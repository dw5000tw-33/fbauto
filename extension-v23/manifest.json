{
  "manifest_version": 3,
  "name": "33 Marketplace 自動上架助手",
  "version": "2.3.0",
  "description": "儲存房屋商品、設定時間，並在 Facebook Marketplace 自動上架。",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "開啟 33 Marketplace 排程助手"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "css": ["styles.css"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
