{
  "manifest_version": 3,
  "name": "33 Marketplace 自動上架助手",
  "version": "2.5.3",
  "description": "管理多個房屋商品排程、固定社團名單，並在 Facebook Marketplace 依序上架。",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "tabs",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "開啟 33 Marketplace 排程助手"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["page-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.facebook.com/*"],
      "css": ["styles.css"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ]
}
